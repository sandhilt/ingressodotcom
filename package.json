{
  "name": "@sandhilt/ingressodotcom-mcp",
  "version": "0.2.1",
  "description": "Claude Code plugin (MCP server + skills) for the public ingresso.com content API",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=24"
  },
  "bin": {
